[Unit]
StartLimitIntervalSec=0

[Container]
AutoUpdate=registry
ContainerName=msmtpd
Environment="PGID=65534"
Environment="PUID=65534"
Environment="SMTP_AUTH={{ 'on' if msmtpd_auth else 'off' }}"
Environment="SMTP_PORT={{ msmtpd_port }}"
Environment="SMTP_STARTTLS={{ 'on' if msmtpd_starttls else 'off' }}"
Environment="SMTP_TLS={{ 'on' if msmtpd_tls else 'off' }}"
HealthCmd=msmtp --file=/dev/null --host=127.0.0.1 --port=2500 --serverinfo
HealthInterval=60s
HealthOnFailure=kill
HealthRetries=3
HealthStartupCmd=msmtp --file=/dev/null --host=127.0.0.1 --port=2500 --serverinfo
HealthStartupInterval=10s
HealthStartupRetries=30
HealthStartupTimeout=10s
HealthTimeout=10s
Image={{ msmtpd_image }}
Notify=healthy
PodmanArgs=--ipc=none
PublishPort={{ msmtpd_publish }}
Secret=msmtpd_from,type=env,target=SMTP_FROM
Secret=msmtpd_host,type=env,target=SMTP_HOST
Secret=msmtpd_password,type=env,target=SMTP_PASSWORD
Secret=msmtpd_user,type=env,target=SMTP_USER

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
