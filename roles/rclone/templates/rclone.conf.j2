{% for remote in rclone_config %}
[{{ remote.name }}]
{%   for key, value in remote | dictsort if key != 'name' %}
{%     if value is sameas true %}
{{ key }} = true
{%     elif value is sameas false %}
{{ key }} = false
{%     else %}
{{ key }} = {{ value }}
{%     endif %}
{%   endfor %}
{%   if not loop.last %}

{%   endif %}
{% endfor %}
